# Lahore Pulse AI — Environment Configuration
# Copy this file to .env and fill in values as needed.
# NEVER commit .env to version control.

# Application
LPA_ENVIRONMENT=development
LPA_LOG_LEVEL=INFO

# API
LPA_API_HOST=0.0.0.0
LPA_API_PORT=8001
LPA_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Database (Phase 1+)
# LPA_DATABASE_URL=sqlite:///data/lahore_pulse.db

# External Data Providers (Phase 1+)
# LPA_OPENAQ_API_KEY=
# LPA_OPEN_METEO_API_KEY=
# LPA_AQICN_API_TOKEN=

# AI Investigation Reasoning (optional — demo works without this)
# LPA_AI_PROVIDER=openai
# LPA_AI_API_KEY=sk-...
# LPA_AI_MODEL=gpt-4o
# LPA_AI_BASE_URL=https://api.openai.com/v1
